# Explicit self-hosted PeerServer endpoint. No public PeerJS fallback.
VITE_PEER_SERVER_URL=http://127.0.0.1:9000/kindred
# Empty works only where direct connectivity is possible (e.g. localhost).
# Production: use your own STUN/TURN. Never place a TURN shared secret here.
VITE_ICE_SERVERS=[]
VITE_RELAY_ONLY=false
