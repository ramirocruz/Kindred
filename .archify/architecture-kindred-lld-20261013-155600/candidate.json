  "cards": [
    { "dot": "cyan", "title": "Control plane", "items": ["BrowserRoom owns one identity peer plus the exclusive coordinator alias", "Authenticated encrypted hello admits members; snapshots carry term, sequence, order, ciphertext history and presentation", "One-second polls and seven-second authority timeout trigger eldest-first alias acquisition", "UUID ordering only avoids duplicate mesh initiation; admission order chooses successors"] },
    { "dot": "emerald", "title": "GDrive request path", "items": ["Any member: player action → controlDrive → authenticated presenter channel", "Presenter: onDriveControl callback → GDriveBridge → content bridge → extension worker", "Worker checks token / room / tab / document, then runs mediaOperation on the pinned video", "Source acknowledgement returns actual time / duration / paused; epoch checks reject stale results", "State polling every 1.5 seconds updates coordinator snapshots; tokens never enter peer frames"] },
    { "dot": "amber", "title": "Read the detailed guide", "items": ["Detailed component contracts, data models, message kinds, cleanup, limits and tests are in the architecture guide", "The diagram's backend-colored modules execute in browsers, not on an application server", "Pending adapters and real-device verification are intentionally not drawn as working components"] }
